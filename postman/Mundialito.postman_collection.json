                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Formato paginado\", () => pm.expect(page).to.include.all.keys(\"data\", \"pageNumber\", \"pageSize\", \"totalRecords\", \"totalPages\"));",
                  "pm.test(\"Todos son programados del equipo\", () => page.data.forEach(m => {",
                  "  pm.expect(m.status).to.eql(\"Scheduled\");",
                  "  pm.expect([m.homeTeamId, m.awayTeamId]).to.include(pm.collectionVariables.get(\"teamId\"));",
                  "}));"
                ]
