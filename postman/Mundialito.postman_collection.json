    {
      "name": "04 · Tabla de posiciones y goleadores",
      "item": [
        {
          "name": "Tabla de posiciones",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/standings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Formato paginado\", () => pm.expect(page).to.include.all.keys(\"data\", \"pageNumber\", \"pageSize\", \"totalRecords\", \"totalPages\"));",
                  "pm.test(\"Orden: puntos, diferencia de gol, goles a favor\", () => {",
                  "  for (let i = 1; i < page.data.length; i++) {",
                  "    const a = page.data[i - 1], b = page.data[i];",
                  "    const key = s => [s.points, s.goalDifference, s.goalsFor];",
                  "    const [pa, da, ga] = key(a), [pb, db, gb] = key(b);",
                  "    pm.expect(pa > pb || (pa === pb && (da > db || (da === db && ga >= gb)))).to.be.true;",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Tabla ordenada por nombre, página 2",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/standings?sortBy=name&sortDirection=asc&pageSize=2&pageNumber=2",
            "description": "Position siempre es el puesto oficial, aunque se ordene por otro campo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Formato paginado\", () => pm.expect(page).to.include.all.keys(\"data\", \"pageNumber\", \"pageSize\", \"totalRecords\", \"totalPages\"));",
                  "pm.test(\"Es la página 2\", () => pm.expect(page.pageNumber).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Goleadores",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/top-scorers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Formato paginado\", () => pm.expect(page).to.include.all.keys(\"data\", \"pageNumber\", \"pageSize\", \"totalRecords\", \"totalPages\"));",
                  "pm.test(\"Ordenados por goles\", () => {",
                  "  const goals = page.data.map(s => s.goals);",
                  "  pm.expect(goals).to.eql([...goals].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ]
        },
        {
