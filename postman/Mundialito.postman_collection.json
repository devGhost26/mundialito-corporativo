            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/api/matches",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"homeTeamId\": \"{{teamId}}\",\n  \"awayTeamId\": \"{{rivalTeamId}}\",\n  \"scheduledAtUtc\": \"2026-11-15T20:00:00Z\",\n  \"venue\": \"Cancha 1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"matchId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Programar otro partido (queda pendiente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
