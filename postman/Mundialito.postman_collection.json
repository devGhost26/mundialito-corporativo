    {
      "name": "05 · Idempotencia",
      "item": [
        {
          "name": "Primera petición con una llave",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{idempotentName}}\",\n  \"city\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"idempotentName\", \"Idempotente \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"idempotentTeamId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Repetir la misma petición: misma respuesta, sin duplicar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{idempotentName}}\",\n  \"city\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Mismo Id que la primera vez\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"idempotentTeamId\")));",
                  "pm.test(\"Marcada como repetida\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Misma llave con otro body: 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Otro nombre {{$timestamp}}\",\n  \"city\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"errorCode es Idempotency.KeyReused\", () => pm.expect(pm.response.json().errorCode).to.eql(\"Idempotency.KeyReused\"));",
                  "pm.test(\"Trae correlationId para soporte\", () => pm.expect(pm.response.json().correlationId).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin Idempotency-Key: 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sin llave {{$timestamp}}\",\n  \"city\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"errorCode es Idempotency.KeyRequired\", () => pm.expect(pm.response.json().errorCode).to.eql(\"Idempotency.KeyRequired\"));",
                  "pm.test(\"Trae correlationId para soporte\", () => pm.expect(pm.response.json().correlationId).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar otra vez el resultado con otra llave: 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/api/matches/{{matchId}}/result",
            "description": "Con otra llave es otra operación, no una repetición: choca con el partido ya jugado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"homeGoals\": 0,\n  \"awayGoals\": 0,\n  \"goals\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"errorCode es Match.AlreadyPlayed\", () => pm.expect(pm.response.json().errorCode).to.eql(\"Match.AlreadyPlayed\"));",
                  "pm.test(\"Trae correlationId para soporte\", () => pm.expect(pm.response.json().correlationId).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    },
