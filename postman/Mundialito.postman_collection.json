{
  "info": {
    "name": "Mundialito Corporativo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API del torneo de fútbol corporativo. Correr las carpetas en orden: cada una guarda los Ids que usan las siguientes.\n\nTodas las peticiones mandan un X-Correlation-Id con prefijo 'postman-' para encontrarlas en los logs y en Jaeger."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: \"X-Correlation-Id\", value: \"postman-\" + pm.variables.replaceIn(\"{{$guid}}\") });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Devuelve X-Correlation-Id y X-Trace-Id\", () => {",
          "  pm.response.to.have.header(\"X-Correlation-Id\");",
          "  pm.response.to.have.header(\"X-Trace-Id\");",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "teamId",
      "value": ""
    },
    {
      "key": "teamName",
      "value": ""
    },
    {
      "key": "rivalTeamId",
      "value": ""
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "matchId",
      "value": ""
    },
    {
      "key": "pendingMatchId",
      "value": ""
    },
    {
      "key": "deletableTeamId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "idempotentName",
      "value": ""
    },
    {
      "key": "idempotentTeamId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 · Salud",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 · Equipos (CRUD, filtros, paginación, orden)",
      "item": [
        {
          "name": "Crear equipo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{teamName}}\",\n  \"city\": \"San Salvador\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"teamName\", \"Postman \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Devuelve Location\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.collectionVariables.set(\"teamId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear equipo rival",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rival {{$timestamp}}\",\n  \"city\": \"Santa Ana\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"rivalTeamId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar equipos: página 1 de 2 en 2, por nombre descendente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/teams?pageNumber=1&pageSize=2&sortBy=name&sortDirection=desc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Formato paginado\", () => pm.expect(page).to.include.all.keys(\"data\", \"pageNumber\", \"pageSize\", \"totalRecords\", \"totalPages\"));",
                  "pm.test(\"Respeta pageSize\", () => pm.expect(page.data.length).to.be.at.most(2));",
                  "pm.test(\"Ordena por nombre descendente\", () => {",
                  "  const names = page.data.map(t => t.name);",
                  "  pm.expect(names).to.eql([...names].sort((a, b) => b.localeCompare(a)));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar equipos por nombre y ciudad",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/teams?name=postman&city=san"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Formato paginado\", () => pm.expect(page).to.include.all.keys(\"data\", \"pageNumber\", \"pageSize\", \"totalRecords\", \"totalPages\"));",
                  "pm.test(\"Todos cumplen el filtro\", () => page.data.forEach(t => {",
                  "  pm.expect(t.name.toLowerCase()).to.include(\"postman\");",
                  "  pm.expect(t.city.toLowerCase()).to.include(\"san\");",
                  "}));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener equipo por Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/teams/{{teamId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
