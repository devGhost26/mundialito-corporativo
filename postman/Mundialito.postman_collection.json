                  "pm.test(\"Es el equipo creado\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"teamId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reemplazar equipo (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/teams/{{teamId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{teamName}}\",\n  \"city\": \"Santa Tecla\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Modificar solo la ciudad (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/teams/{{teamId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"San Miguel\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear equipo para eliminar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": "{{baseUrl}}/api/teams",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Borrable {{$timestamp}}\",\n  \"city\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"deletableTeamId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar equipo (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/teams/{{deletableTeamId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar otra vez: DELETE idempotente",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/teams/{{deletableTeamId}}",
            "description": "El equipo ya no existe y responde 204 igual: el estado final es el mismo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
