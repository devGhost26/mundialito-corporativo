              }
            ],
            "url": "{{baseUrl}}/api/matches",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"homeTeamId\": \"{{rivalTeamId}}\",\n  \"awayTeamId\": \"{{teamId}}\",\n  \"scheduledAtUtc\": \"2026-11-22T20:00:00Z\",\n  \"venue\": \"Cancha 2\"\n}",
              "options": {
